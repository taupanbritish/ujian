# Port API
PORT=4310

# NODE_ENV sengaja tidak ditulis di berkas ini. Vite ikut membaca .env, dan nilai
# "development" di sini membuat `npm run build` membundel React versi development
# (lebih besar, lebih lambat, memunculkan peringatan di konsol). Biarkan Vite dan
# platform hosting yang menentukan: `vite build` otomatis memakai "production".
# Bila perlu memaksa, set lewat environment shell: NODE_ENV=production npm start

# PostgreSQL — arahkan ke database cloud Anda (Neon / Supabase / Railway / RDS).
# Contoh Neon: postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/cendekia?sslmode=require
DATABASE_URL=postgresql://cendekia:cendekia@127.0.0.1:5433/cendekia

# Aktifkan SSL untuk host cloud (otomatis aktif bila host bukan localhost, kecuali DATABASE_SSL=false)
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Ganti dengan nilai acak panjang untuk produksi: openssl rand -hex 32
JWT_SECRET=ganti-dengan-rahasia-acak-untuk-produksi
JWT_EXPIRES=12h

# Akun yang dibuat seeder (tidak ditampilkan di antarmuka aplikasi).
# Pakai tanda kutip bila nilai mengandung # atau $ agar tidak dipotong dotenv.
SEED_ADMIN_EMAIL=admin@cendekia.sch.id
SEED_ADMIN_PASSWORD="Cendekia#2026"
SEED_GURU_PASSWORD="Cendekia#2026"
SEED_SISWA_PASSWORD="Cendekia#2026"
# Tombol masuk cepat satu klik untuk akun demo. Wajib false di produksi.
DEMO_MASUK=true

# ── Identitas sekolah (white-label) ──────────────────────────────────────────
# Distribusi ke sekolah lain cukup mengubah nilai di bawah ini, lalu jalankan
# migrasi + seeder. Nama sekolah, nama aplikasi, dan tahun ajaran juga dapat
# diubah langsung dari menu "Pengaturan Sekolah" (admin) tanpa seed ulang.
#
# Jenjang: SD | SMP | SMA | SMK. Menentukan tingkat kelas, mata pelajaran, dan
# paket soal demo. Dikunci saat distribusi (tidak diubah dari antarmuka).
SEKOLAH_JENJANG=SMP
# Nama sekolah tampil di seluruh antarmuka. Kosongkan untuk bawaan "<Jenjang> Cendekia Nusantara".
SEKOLAH_NAMA="SMP Cendekia Nusantara"
TAHUN_AJARAN="2026/2027"
# Kata pertama jadi nama utama, sisanya jadi lencana (mis. "ShanaTech CBT").
NAMA_APLIKASI="ShanaTech CBT"
