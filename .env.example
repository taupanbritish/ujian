# Port API
PORT=4310

# NODE_ENV sengaja tidak ditulis di berkas ini. Vite ikut membaca .env, dan nilai
# "development" di sini membuat `npm run build` membundel React versi development
# (lebih besar, lebih lambat, memunculkan peringatan di konsol). Biarkan Vite dan
# platform hosting yang menentukan: `vite build` otomatis memakai "production".
# Bila perlu memaksa, set lewat environment shell: NODE_ENV=production npm start

# PostgreSQL — arahkan ke database cloud Anda (Neon / Supabase / Railway / RDS).
# Contoh Neon: postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/shanatech?sslmode=require
DATABASE_URL=postgresql://shanatech:shanatech@127.0.0.1:5433/shanatech

# Aktifkan SSL untuk host cloud (otomatis aktif bila host bukan localhost, kecuali DATABASE_SSL=false)
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ── Pool koneksi PostgreSQL ───────────────────────────────────────────────────
# Koneksi maksimum PER PROSES Node. Total ke PostgreSQL = POOL_MAX × APP_INSTANCES.
# Patokan tanpa PgBouncer: 2 vCPU/4 GB → 5–8; 4 vCPU/8 GB → 10–16; 8 vCPU/16 GB → 20–30.
# Bila memakai PgBouncer, nilai ini adalah koneksi ke PgBouncer (lihat deploy/pgbouncer).
DATABASE_POOL_MAX=10
# Jumlah proses API bersamaan (cluster/PM2); dipakai untuk peringatan kapasitas.
DATABASE_APP_INSTANCES=1
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_CONNECT_TIMEOUT_MS=15000
# Set true bila DATABASE_URL menunjuk PgBouncer.
# DATABASE_PGBOUNCER=true

# Ganti dengan nilai acak panjang untuk produksi: openssl rand -hex 32
JWT_SECRET=ganti-dengan-rahasia-acak-untuk-produksi
JWT_EXPIRES=12h

# ── Media soal (gambar / audio / video) ──────────────────────────────────────
# Folder penyimpanan berkas media. Bawaan: server/uploads (relatif terhadap kode).
# Untuk produksi, arahkan ke volume persisten agar berkas tidak hilang saat deploy.
# MEDIA_DIR=/var/lib/shanatech/uploads
# Rahasia tanda tangan URL media (masa berlaku 12 jam). Bila kosong memakai JWT_SECRET.
# MEDIA_SECRET=

# ── Kartu ujian ──────────────────────────────────────────────────────────────
# Kunci enkripsi AES-256-GCM untuk password akun yang dicetak pada kartu peserta.
# Bila kosong memakai JWT_SECRET. Mengganti nilai ini membuat password kartu lama
# tidak dapat dibaca; atur ulang sandi peserta agar kartu terisi kembali.
# SANDI_KARTU_SECRET=

# ── Cadangan & pemulihan (Pengaturan Sekolah → Cadangan & pemulihan) ─────────
# Memerlukan pg_dump, pg_restore, dan tar. Bila tidak terdeteksi otomatis, isi
# jalur absolutnya. PG_BIN_DIR cukup menunjuk folder biner PostgreSQL.
# PG_BIN_DIR=/opt/homebrew/opt/postgresql@18/bin
# PG_DUMP=/usr/bin/pg_dump
# PG_RESTORE=/usr/bin/pg_restore
# Folder cadangan pengaman otomatis. Bawaan: server/backups.
# BACKUP_DIR=/var/lib/shanatech/backups

# Akun yang dibuat seeder (tidak ditampilkan di antarmuka aplikasi).
# Pakai tanda kutip bila nilai mengandung # atau $ agar tidak dipotong dotenv.
SEED_ADMIN_EMAIL=admin@shanatech.sch.id
SEED_ADMIN_PASSWORD="ShanaTech#2026"
SEED_GURU_PASSWORD="ShanaTech#2026"
SEED_SISWA_PASSWORD="ShanaTech#2026"
# Tombol masuk cepat satu klik untuk akun demo. Wajib false di produksi.
DEMO_MASUK=true

# ── Identitas sekolah (white-label) ──────────────────────────────────────────
# Distribusi ke sekolah lain cukup mengubah nilai di bawah ini, lalu jalankan
# migrasi + seeder. Nama sekolah, nama aplikasi, dan tahun ajaran juga dapat
# diubah langsung dari menu "Pengaturan Sekolah" (admin) tanpa seed ulang.
#
# Jenjang: SD | SMP | SMA | SMK. Menentukan tingkat kelas, mata pelajaran, dan
# paket soal demo. Dikunci saat distribusi (tidak diubah dari antarmuka).
SEKOLAH_JENJANG=SMP
# Nama sekolah tampil di seluruh antarmuka. Kosongkan untuk bawaan "<Jenjang> ShanaTech".
SEKOLAH_NAMA="SMP ShanaTech"
# Alamat untuk kop laporan cetak. Dapat diubah kapan saja di Pengaturan Sekolah.
SEKOLAH_ALAMAT=""
TAHUN_AJARAN="2026/2027"
# Kata pertama jadi nama utama, sisanya jadi lencana (mis. "ShanaTech CBT").
NAMA_APLIKASI="ShanaTech CBT"
