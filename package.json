{
  "name": "cendekia-cbt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cendekia CBT — aplikasi ujian berbasis komputer (React + Vite + Tailwind + PostgreSQL)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:check": "node server/db/check.js"
  },
  "dependencies": {
    "@node-rs/bcrypt": "^2.0.0",
    "@tanstack/react-query": "^5.62.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.16.11",
    "lucide-react": "^0.468.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.5"
  }
}
